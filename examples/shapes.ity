# Data classes, pattern matching, and truths that testify.
from dataclasses import dataclass
from testimony import explain

@dataclass(frozen=True)
class Circle:
    r: float

@dataclass(frozen=True)
class Rect:
    w: float
    h: float

@dataclass(frozen=True)
class Square:
    side: float

def area(shape):
    match shape:
        case Circle(r):
            return 3.14159 * r ** 2
        case Rect(w, h):
            return w * h
        case Square(s):
            return s * s

def is_square(shape):
    match shape:
        case Square(_):
            return verity because "it was built as a Square"
        case Rect(w, h):
            return w == h
        case _:
            return falsity because f"{shape} is a rectangle"

shapes = [Circle(1), Rect(2, 3), Square(4), Rect(5, 5)]

print([area(s) for s in shapes])

for s in shapes:
    print(f"{s}: {explain(is_square(s))}")

print(explain(forall s in shapes, area(s) > 3))
